+                        <executions>
+                            <execution>
+                                <id>generate-openapi-from-test-sources</id>
+                                <phase>process-test-classes</phase>
+                                <goals>
+                                    <goal>execute</goal>
+                                </goals>
+                                <configuration>
+                                    <includeClasspath>PROJECT_AND_PLUGIN</includeClasspath>
+                                    <scripts>
+                                        <script><![CDATA[
+import io.swagger.v3.core.util.Json
+import io.swagger.v3.jaxrs2.Reader
+import io.swagger.v3.oas.integration.SwaggerConfiguration
+import io.swagger.v3.oas.models.OpenAPI
+import java.nio.charset.StandardCharsets
+import java.nio.file.Files
+import java.nio.file.Path
+import java.nio.file.Paths
+
+Path testOutputDirectory = Paths.get(project.build.testOutputDirectory)
+if (!Files.exists(testOutputDirectory)) {
+    throw new IllegalStateException("Test classes directory does not exist: ${testOutputDirectory}")
+}
+
+Set<Class<?>> resourceClasses = new LinkedHashSet<>()
+ClassLoader classLoader = Thread.currentThread().contextClassLoader
+
+Files.walk(testOutputDirectory)
+        .filter { Files.isRegularFile(it) }
+        .filter { it.fileName.toString().endsWith('.class') }
+        .filter { !it.fileName.toString().contains('$') }
+        .forEach { classFile ->
+            String className = testOutputDirectory
+                    .relativize(classFile)
+                    .toString()
+                    .replace(java.io.File.separatorChar, '.' as char)
+                    .replaceAll(/\.class$/, '')
+            Class<?> candidate = classLoader.loadClass(className)
+            if (candidate.getAnnotation(jakarta.ws.rs.Path) != null
+                    || candidate.getAnnotation(jakarta.ws.rs.ApplicationPath) != null
+                    || candidate.getAnnotation(io.swagger.v3.oas.annotations.OpenAPIDefinition) != null
+                    || candidate.getAnnotation(io.swagger.v3.oas.annotations.Webhooks) != null) {
+                resourceClasses.add(candidate)
+            }
+        }
+
+if (resourceClasses.isEmpty()) {
+    throw new IllegalStateException("No Jakarta REST/OpenAPI annotated test classes were found under ${testOutputDirectory}")
+}
+
+SwaggerConfiguration configuration = new SwaggerConfiguration()
+configuration.setOpenAPI(new OpenAPI().openapi('3.0.3'))
+configuration.setOpenAPIVersion('3.0.3')
+configuration.setOpenAPI31(Boolean.FALSE)
+configuration.setPrettyPrint(Boolean.TRUE)
+configuration.setReadAllResources(Boolean.TRUE)
+
+OpenAPI openAPI = new Reader(configuration).read(resourceClasses)
+Path outputDirectory = Paths.get(project.build.directory, 'generated-openapi')
+Files.createDirectories(outputDirectory)
+Path outputFile = outputDirectory.resolve('openapi.json')
+Files.write(outputFile, Json.pretty(openAPI).getBytes(StandardCharsets.UTF_8))
+log.info("Generated OpenAPI document: ${outputFile.toAbsolutePath()}")
+]]></script>
